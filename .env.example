# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Directory where source PDFs (policies, bills) are read from.
DATA_DIR=./data

# Directory where policy PDFs live.
POLICIES_DIR=./data/policies

# Directory where bill PDFs live.
BILLS_DIR=./data/bills

# Chunking configuration (characters, not tokens, for Phase 1 simplicity).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# RAG / retrieval configuration (Phase 2).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_DIR=./data/vector_store
RETRIEVAL_TOP_K=5
RETRIEVAL_RELEVANCE_THRESHOLD=0.35

# LLM extraction configuration (Phase 3). LLM_PROVIDER is "groq" or "ollama".
LLM_PROVIDER=groq

# Required only when LLM_PROVIDER=groq. Get a key at https://console.groq.com
# Never commit a real key — this file is a template only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used only when LLM_PROVIDER=ollama. Requires a local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
