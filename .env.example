# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Directory where source PDFs (policies, bills) are read from.
DATA_DIR=./data

# Directory where policy PDFs live.
POLICIES_DIR=./data/policies

# Directory where bill PDFs live.
BILLS_DIR=./data/bills

# Chunking configuration (characters, not tokens, for Phase 1 simplicity).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
